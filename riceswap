#!/usr/bin/env bash
# ==============================================================================
# riceswap - Dynamic, safe profile swapper for Wayland desktops and overlays
# Consolidated, streamlined, self-contained single-file utility
# ==============================================================================

set -euo pipefail

# --- 1. Path Configurations & Overrides ---
export STORE_DIR="${STORE_DIR:-$HOME/.config/riceswap}"
export PROFILES_DIR="$STORE_DIR/profiles"
export CONFIG_FILE="$STORE_DIR/config"
export AUTOLOG_STATE_FILE="$STORE_DIR/autolog"

export LOGOUT_METHOD="loginctl"
export AUTOLOG_ENABLED=false

log_info() { echo -e "\e[34m[INFO]\e[0m $1"; }
log_success() { echo -e "\e[32m[SUCCESS]\e[0m $1"; }
log_warn() { echo -e "\e[33m[WARN]\e[0m $1"; }
log_error() { echo -e "\e[31m[ERROR]\e[0m $1"; }

ensure_dirs() {
    mkdir -p "$PROFILES_DIR"
}

load_autolog_state() {
    if [ -f "$AUTOLOG_STATE_FILE" ] && [ "$(cat "$AUTOLOG_STATE_FILE" 2>/dev/null)" = "true" ]; then
        AUTOLOG_ENABLED=true
    fi
}

load_config() {
    if [ -f "$CONFIG_FILE" ]; then
        # shellcheck source=/dev/null
        source "$CONFIG_FILE"
    fi
}

get_sorted_profiles() {
    if [ -d "$PROFILES_DIR" ]; then
        /bin/ls -1tr "$PROFILES_DIR" 2>/dev/null || true
    fi
}

get_active_profile() {
    for link in "$HOME/.config"/*; do
        if [ -L "$link" ]; then
            local real_target
            real_target=$(readlink -f "$link" 2>/dev/null || true)
            if [[ "$real_target" == "$PROFILES_DIR"/* ]]; then
                # Extract the profile directory name directly
                local relative_path="${real_target#$PROFILES_DIR/}"
                echo "${relative_path%%/*}"
                return 0
            fi
        fi
    done
    echo ""
}

# --- 2. Dynamic Daemon Restarts & Smooth Remaps (Feature 3) ---
reload_desktop_overlays() {
    # Reload compositor config dynamically based on detection quietly
    if pgrep -x hyprland >/dev/null || [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        hyprctl reload &>/dev/null || true
    elif pgrep -x sway >/dev/null; then
        swaymsg reload &>/dev/null || true
    elif pgrep -x river >/dev/null; then
        riverctl control-location reload &>/dev/null || true
    fi
    
    # Graceful reload signals (USR2 for waybar, reload rules for mako/dunst, etc.) quietly
    if pgrep -x waybar >/dev/null; then
        killall -USR2 waybar &>/dev/null || true
    fi
    if pgrep -x mako >/dev/null; then
        makoctl reload &>/dev/null || true
    fi
    if pgrep -x dunst >/dev/null; then
        dunstc reload &>/dev/null || true
    fi
    if pgrep -x ags >/dev/null; then
        ags -r "rc()" &>/dev/null || killall -USR1 ags &>/dev/null || true
    fi
}

terminate_graphical_session() {
    log_info "Executing graphical exit via: $LOGOUT_METHOD"
    case "$LOGOUT_METHOD" in
        loginctl)
            loginctl terminate-user "$USER"
            ;;
        systemd)
            systemctl --user stop hyprland.target 2>/dev/null || loginctl terminate-user "$USER"
            ;;
        hyprctl|*)
            if pgrep -x hyprland >/dev/null; then
                hyprctl dispatch exit || true
            else
                killall -9 sway river hyprland 2>/dev/null || loginctl terminate-user "$USER"
            fi
            ;;
    esac
}

show_help() {
    cat << EOF
$(echo -e "\e[1;36mriceswap v0.60\e[0m") - Dynamic, safe profile swapper for Wayland desktops

$(echo -e "\e[1;33mUSAGE:\e[0m")
  riceswap <COMMAND> [ARGS]

$(echo -e "\e[1;33mCORE COMMANDS:\e[0m")
  $(echo -e "\e[1;32minit\e[0m")                       Initialize the engine settings and profiles directory
  $(echo -e "\e[1;32mlist\e[0m")                       List available desktop profiles (oldest first)
  $(echo -e "\e[1;32mset [profile/index/cmd] [--nolog/-nl]\e[0m")   Swap to a profile dynamically
  $(echo -e "\e[1;32mcreate <profile>\e[0m")           Create a skeleton profile folder
  $(echo -e "\e[1;32mdelete <profile>\e[0m")           Safely purge a profile directory
  $(echo -e "\e[1;32mautolog\e[0m")                    Toggle automatic session logout/restart on swap

$(echo -e "\e[1;33mSHARING COMMANDS:\e[0m")
  $(echo -e "\e[1;32mexport <profile> [out_dir]\e[0m") Package a profile folder into a portable .tar.gz
  $(echo -e "\e[1;32mimport <file.tar.gz>\e[0m")       Decompress and install a profile from .tar.gz

$(echo -e "\e[1;33mUTILITY COMMANDS:\e[0m")
  $(echo -e "\e[1;32mupdate\e[0m")                     Replaces script with the (probably newer) version from github.

$(echo -e "\e[1;33mSWAPPING CONVENIENCES:\e[0m")
  $(echo -e "\e[1;34mrandom\e[0m")                     Swap to a randomly selected profile
  $(echo -e "\e[1;34mscroll\e[0m")                     Cycle to the next profile sequentially

$(echo -e "\e[1;33mOPTIONS FOR 'set':\e[0m")
  $(echo -e "\e[1;32m--nolog, -nl\e[0m")                Bypass auto-logout/force-logout for this run, triggering active overlay reload instead
EOF
}

init_swapper() {
    ensure_dirs
    if [ ! -f "$CONFIG_FILE" ]; then
        cat << 'EOF' > "$CONFIG_FILE"
# RiceSwap Global Settings File
LOGOUT_METHOD="loginctl"

pre_swap_hook() {
    local target="$1"
    return 0
}

post_swap_hook() {
    local target="$1"
    return 0
}
EOF
        log_success "Generated configuration skeleton at $CONFIG_FILE"
    fi
}

toggle_autolog() {
    load_autolog_state
    if [ "$AUTOLOG_ENABLED" = true ]; then
        echo "false" > "$AUTOLOG_STATE_FILE"
        log_success "Autolog disabled. Swifts will perform smooth overlay reloads."
    else
        echo "true" > "$AUTOLOG_STATE_FILE"
        log_success "Autolog enabled. Swifts will force-logout to apply changes instantly."
    fi
}

list_profiles() {
    local active
    active=$(get_active_profile)

    echo -e "\e[1;34mAvailable Profiles:\e[0m"
    echo "--------------------------------------"
    local idx=1
    while IFS= read -r name; do
        [ -z "$name" ] && continue
        if [ "$name" == "$active" ]; then
            echo -e "  \e[1;32m$idx) $name (active) *\e[0m"
        else
            echo "  $idx) $name"
        fi
        idx=$((idx + 1))
    done < <(get_sorted_profiles)
}

create_profile() {
    local name="$1"
    local path="$PROFILES_DIR/$name"

    if [ -d "$path" ]; then
        log_warn "Profile '$name' already exists."
        exit 0
    fi

    mkdir -p "$path"
    log_success "Created profile directory '$name' at $path"
    log_info "Place tool configuration folders (like 'hypr', 'waybar', etc.) directly inside it."
}

delete_profile() {
    local target="$1"
    local active
    active=$(get_active_profile)

    if [[ "$target" =~ ^[0-9]+$ ]]; then
        local profiles=()
        while IFS= read -r name; do
            [ -n "$name" ] && profiles+=("$name")
        done < <(get_sorted_profiles)
        local target_idx=$((target - 1))
        if [ "$target_idx" -ge 0 ] && [ "$target_idx" -lt "${#profiles[@]}" ]; then
            target="${profiles[target_idx]}"
        else
            log_error "Invalid profile index: $target"
            exit 1
        fi
    fi

    local target_path="$PROFILES_DIR/$target"
    if [ ! -d "$target_path" ]; then
        log_error "Profile '$target' does not exist."
        exit 1
    fi

    if [ "$target" == "$active" ]; then
        log_error "Cannot delete active profile '$target'!"
        exit 1
    fi

    rm -rf "$target_path"
    log_success "Purged profile '$target'."
}

export_profile() {
    local name="$1"
    local path="$PROFILES_DIR/$name"
    if [ ! -d "$path" ]; then
        log_error "Profile '$name' does not exist."
        exit 1
    fi
    local out_dir="${2:-.}"
    mkdir -p "$out_dir"
    local tar_file="$out_dir/$name.tar.gz"
    tar -czf "$tar_file" -C "$PROFILES_DIR" "$name"
    log_success "Packaged profile '$name' into $tar_file"
}

import_profile() {
    local archive="$1"
    if [ ! -f "$archive" ]; then
        log_error "Archive file '$archive' not found."
        exit 1
    fi
    if [[ "$archive" != *.tar.gz ]]; then
        log_error "Import argument must be a valid .tar.gz archive."
        exit 1
    fi
    local profile_name
    profile_name=$(basename "$archive" .tar.gz)
    
    if [ -d "$PROFILES_DIR/$profile_name" ]; then
        log_warn "Profile '$profile_name' already exists. Overwrite? [y/N]: "
        if [ -t 0 ]; then
            read -r resp
            if [[ ! "$resp" =~ ^[yY] ]]; then
                log_info "Import cancelled."
                exit 0
            fi
            rm -rf "$PROFILES_DIR/$profile_name"
        else
            log_error "Profile '$profile_name' already exists and terminal is non-interactive."
            exit 1
        fi
    fi
    tar -xzf "$archive" -C "$PROFILES_DIR"
    log_success "Successfully imported profile: $profile_name"
}

update_swapper() {
    log_info "Checking for updates from GitHub (im-vihar/riceswap)..."
    if ! command -v curl &>/dev/null; then
        log_error "curl is required to update riceswap."
        exit 1
    fi

    local script_path
    script_path=$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$HOME/.local/bin/riceswap")

    log_info "Downloading latest riceswap bash script..."
    local tmp_file
    tmp_file=$(mktemp)

    if curl -fsSL "https://raw.githubusercontent.com/im-vihar/riceswap/main/riceswap" -o "$tmp_file"; then
        chmod +x "$tmp_file"
        # Validate syntax of downloaded file first
        if bash -n "$tmp_file" &>/dev/null; then
            mv "$tmp_file" "$script_path"
            log_success "riceswap updated successfully at $script_path!"
        else
            log_error "Downloaded file failed syntax validation. Aborting update."
            rm -f "$tmp_file"
            exit 1
        fi
    else
        log_error "Failed to download update from GitHub."
        rm -f "$tmp_file"
        exit 1
    fi
}

set_profile() {
    local target=""
    local opt_nolog=false

    # Parse options
    while [ $# -gt 0 ]; do
        case "$1" in
            --nolog|-nl)
                opt_nolog=true
                shift
                ;;
            -*)
                log_error "Unknown option: $1"
                exit 1
                ;;
            *)
                if [ -z "$target" ]; then
                    target="$1"
                else
                    log_error "Unexpected argument: $1"
                    exit 1
                fi
                shift
                ;;
        esac
    done

    local profiles=()
    while IFS= read -r name; do
        [ -n "$name" ] && profiles+=("$name")
    done < <(get_sorted_profiles)

    local count=${#profiles[@]}
    if [ "$count" -eq 0 ]; then
        log_error "No profiles found. Run 'riceswap create <name>' first."
        exit 1
    fi

    local active
    active=$(get_active_profile)

    local active_idx=-1
    for i in "${!profiles[@]}"; do
        if [ "${profiles[i]}" == "$active" ]; then
            active_idx=$i
            break
        fi
    done

    # --- 3. Simple Dynamic Inline Selection ---
    if [ -z "$target" ]; then
        if [ ! -t 0 ] || [ ! -t 1 ]; then
            log_error "No profile specified and standard input/output is not a terminal."
            exit 1
        fi
        echo -n "Profiles: "
        for i in "${!profiles[@]}"; do
            local num=$((i + 1))
            if [ $i -gt 0 ]; then echo -n " | "; fi
            if [ "${profiles[i]}" == "$active" ]; then
                echo -n -e "\e[1;32m$num) ${profiles[i]} (active)\e[0m"
            else
                echo -n "$num) ${profiles[i]}"
            fi
        done
        echo ""
        echo -n "Select profile [1-$count]: "
        read -r choice || { echo ""; exit 1; }
        target="$choice"
    fi

    # Handle keywords
    if [ "$target" == "random" ]; then
        local rand_idx=$(( RANDOM % count ))
        target="${profiles[rand_idx]}"
    elif [ "$target" == "scroll" ]; then
        if [ "$active_idx" -eq -1 ]; then
            target="${profiles[0]}"
        else
            local next_idx=$(( (active_idx + 1) % count ))
            target="${profiles[next_idx]}"
        fi
    elif [[ "$target" =~ ^[0-9]+$ ]]; then
        local target_idx=$((target - 1))
        if [ "$target_idx" -ge 0 ] && [ "$target_idx" -lt "$count" ]; then
            target="${profiles[target_idx]}"
        else
            log_error "Invalid profile ID: $target"
            exit 1
        fi
    fi

    local target_path="$PROFILES_DIR/$target"
    if [ ! -d "$target_path" ]; then
        log_error "Profile '$target' does not exist."
        exit 1
    fi

    # Execute custom hook before linking
    if declare -f pre_swap_hook > /dev/null; then
        pre_swap_hook "$target"
    fi

    # --- 1. Dynamic Profile Reconciliation & Symlink Shift ---
    # Stop programs that were configured in the old profile but are not present in the new one
    if [ -n "$active" ] && [ "$active" != "$target" ]; then
        local old_profile_path="$PROFILES_DIR/$active"
        for app_dir in "$old_profile_path"/*; do
            [ ! -d "$app_dir" ] && continue
            local app_name
            app_name=$(basename "$app_dir")
            
            # If the application config doesn't exist in the new profile, clean it up completely
            if [ ! -d "$target_path/$app_name" ]; then
                local conf_path="$HOME/.config/$app_name"
                if [ -L "$conf_path" ]; then
                    rm -f "$conf_path"
                elif [ -d "$conf_path" ]; then
                    log_warn "Pre-existing real directory detected at $conf_path. Backing up to ${conf_path}.bak..."
                    rm -rf "${conf_path}.bak"
                    mv "$conf_path" "${conf_path}.bak"
                fi
                case "$app_name" in
                    waybar|quickshell|ags|yabar|polybar|i3bar)
                        killall -9 "$app_name" &>/dev/null || true
                        ;;
                    mako)
                        makoctl dismiss -a &>/dev/null || killall -9 mako &>/dev/null || true
                        ;;
                    dunst)
                        killall -9 dunst &>/dev/null || true
                        ;;
                esac
            fi
        done
    fi

    # Atomically link all directories inside the target profile
    for app_dir in "$target_path"/*; do
        [ ! -d "$app_dir" ] && continue
        local app_name
        app_name=$(basename "$app_dir")
        local dest_link="$HOME/.config/$app_name"
        
        # If dest_link exists and is a real physical directory (not a symlink), back it up first
        if [ -d "$dest_link" ] && [ ! -L "$dest_link" ]; then
            log_warn "Pre-existing real directory detected at $dest_link. Backing up to ${dest_link}.bak..."
            rm -rf "${dest_link}.bak"
            mv "$dest_link" "${dest_link}.bak"
        fi

        local tmp_link="${dest_link}.tmp"
        rm -rf "$tmp_link"
        ln -sfn "$app_dir" "$tmp_link"
        mv -Tf "$tmp_link" "$dest_link"
    done

    # Execute custom hook after linking
    if declare -f post_swap_hook > /dev/null; then
        post_swap_hook "$target"
    fi

    # Reload / Auto-login execution
    if [ "$AUTOLOG_ENABLED" = true ] && [ "$opt_nolog" = false ]; then
        { notify-send -r 9999 -t 2000 -a "riceswap" "RiceSwap" "Switched: $target. Exiting session..." & } &>/dev/null || true
        sleep 0.5
        terminate_graphical_session
    else
        reload_desktop_overlays
        if [ -t 1 ]; then
            log_success "Swapped to profile: $target"
        else
            { notify-send -r 9999 -t 2000 -a "riceswap" "RiceSwap" "Profile applied: $target" & } &>/dev/null || true
        fi
    fi
}

ensure_dirs
load_autolog_state
load_config

if [ $# -lt 1 ]; then
    show_help
    exit 0
fi

COMMAND="$1"
shift

case "$COMMAND" in
    -h|--help|help) show_help ;;
    init)    init_swapper ;;
    list)    list_profiles ;;
    set)     set_profile "$@" ;;
    autolog) toggle_autolog ;;
    create)  [ $# -lt 1 ] && log_error "Usage: riceswap create <name>" || create_profile "$1" ;;
    delete)  [ $# -lt 1 ] && log_error "Usage: riceswap delete <name/index>" || delete_profile "$1" ;;
    export)  [ $# -lt 1 ] && log_error "Usage: riceswap export <profile> [out_dir]" || export_profile "$1" "${2:-.}" ;;
    import)  [ $# -lt 1 ] && log_error "Usage: riceswap import <file.tar.gz>" || import_profile "$1" ;;
    update)  update_swapper ;;
    *)       show_help; exit 1 ;;
esac
